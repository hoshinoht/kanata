# Copy to .env (git-ignored). Compose inputs only: file paths, never secret values.
COMPOSE_PROJECT_NAME=kanata
# Add :deploy/compose/compose.kanata.host-ollama.yml for Ollama on the Docker host and
# :deploy/compose/compose.kanata.public.yml for the Cloudflare tunnel,
# :deploy/compose/compose.kanata.chatgpt.yml for private ChatGPT plan usage.
COMPOSE_FILE=deploy/compose/compose.kanata.yml
# Image tag used by Compose and deploy/scripts/kanata.sh (default kanata:test).
# KANATA_IMAGE=kanata:dev
KANATA_CONFIG_FILE=/absolute/path/to/kanata/config/config.toml
# Must be <config dir>/keys and <config dir>/state (checked by deploy/scripts/kanata.sh).
KANATA_KEYS_DIR=/absolute/path/to/kanata/config/keys
KANATA_STATE_DIR=/absolute/path/to/kanata/config/state
# Only with deploy/compose/compose.kanata.public.yml:
# KANATA_CLOUDFLARED_TOKEN_FILE=/absolute/path/outside/repo/cloudflared-tunnel-token
# With deploy/compose/compose.kanata.openrouter.yml:
# KANATA_OPENROUTER_KEY_FILE=/absolute/path/outside/repo/openrouter-api-key
# With deploy/compose/compose.kanata.anthropic.yml (private only):
# KANATA_ANTHROPIC_KEY_FILE=/absolute/path/outside/repo/anthropic-api-key
# With deploy/compose/compose.kanata.omnilion.yml (after deploy/compose/compose.kanata.public.yml):
# KANATA_OMNILION_KEY_FILE=/absolute/path/outside/repo/omnilion-api-key
# With deploy/compose/compose.kanata.chatgpt.yml: the same path as [chatgpt_auth].state_dir.
# Host browser sign-in and private container inference share this directory (0700).
# KANATA_CHATGPT_STATE_DIR=/absolute/path/outside/repo/kanata-chatgpt
# With deploy/compose/compose.kanata.cliproxy.yml (CLIProxyAPI plus a TLS sidecar):
# CLIPROXY_TLS_DIR=/absolute/path/outside/repo/cliproxy-tls   # deploy/scripts/cliproxy-tls-certs.sh output
# KANATA_CLIPROXY_KEY_FILE=/absolute/path/outside/repo/cliproxy-client-key
# CLIProxyAPI's existing config and sign-in directory (tsuna: ~/.config/tsuna/.runtime/proxy/...):
# CLIPROXY_CONFIG_FILE=/absolute/path/outside/repo/cliproxy/config.yaml
# CLIPROXY_AUTH_DIR=/absolute/path/outside/repo/cliproxy/auth
