# Copy to .env (git-ignored). Compose inputs only: file paths, never secret values.
COMPOSE_PROJECT_NAME=kanata
# Add :compose.kanata.host-ollama.yml for Ollama on the Docker host and
# :compose.kanata.public.yml for the Cloudflare tunnel.
COMPOSE_FILE=compose.kanata.yml
# Image tag used by Compose and scripts/kanata.sh (default kanata:test).
# KANATA_IMAGE=kanata:dev
KANATA_CONFIG_FILE=/absolute/path/to/kanata/config/config.toml
# Must be <config dir>/keys and <config dir>/state (checked by scripts/kanata.sh).
KANATA_KEYS_DIR=/absolute/path/to/kanata/config/keys
KANATA_STATE_DIR=/absolute/path/to/kanata/config/state
# Host-side owner key file, written by `scripts/kanata.sh owner-key rotate`; Kanata only stores its digest.
KANATA_OWNER_KEY_FILE=/absolute/path/outside/repo/owner-client-key
# Only with compose.kanata.public.yml:
# KANATA_CLOUDFLARED_TOKEN_FILE=/absolute/path/outside/repo/cloudflared-tunnel-token
# With compose.kanata.openrouter.yml:
# KANATA_OPENROUTER_KEY_FILE=/absolute/path/outside/repo/openrouter-api-key
# With compose.kanata.omnilion.yml (after compose.kanata.public.yml):
# KANATA_OMNILION_KEY_FILE=/absolute/path/outside/repo/omnilion-api-key
